function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

// "Bring back" = made 14-30 days ago (in the last month, but not the last 2 weeks).
// "Fresh"      = not made in over a month (includes never-made).
function suggestMeals() {
  const inWeek = new Set(Object.values(state.week));
  const comebackPool = state.meals.filter(m => {
    if (inWeek.has(m.n) || !m.l) return false;
    const d = daysSince(m.l);
    return d >= 14 && d <= 30;
  });
  const freshPool = state.meals.filter(m => {
    if (inWeek.has(m.n)) return false;
    return daysSince(m.l) > 30; // 9999 if never made
  });
  renderSuggestions(shuffle(comebackPool).slice(0, 3), shuffle(freshPool).slice(0, 3));
}

