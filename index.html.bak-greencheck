  }).join('');
}

function daysSince(dateStr) {
  if (!dateStr) return 9999;
  const then = new Date(dateStr);
  const now = new Date();
  return Math.floor((now - then) / (1000 * 60 * 60 * 24));
}

function escapeQ(s) { return (s || '').replace(/'/g, "\\'"); }

// Local-timezone YYYY-MM-DD. Using toISOString() returns UTC, which rolls
// over to "tomorrow" once it's late evening Pacific time.
function todayLocal() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

function hadTonight(mealName) {
  const meal = state.meals.find(m => m.n === mealName);
  if (!meal) return;
  const today = todayLocal();
  meal.l = today;
  state.history.unshift({date: today, meal: mealName});
  state.history = state.history.slice(0, 180);
  save();
  renderAll();
  toast(`✓ Logged: ${mealName}`);
  cloudWrite(async () => {
    await sb.from('dinner_history').insert({ meal_name: mealName, date: today });
    await sb.from('meals').update({ last_made: today }).eq('name', mealName);
  }, 'hadTonight');
}

