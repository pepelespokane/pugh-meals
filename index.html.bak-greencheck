<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0; padding: 0;
    background: #f5f7fa;
    color: #1a2340;
    font-size: 16px;
    line-height: 1.5;
  }
  header {
    background: #1a3a5c;
    color: #fff;
    padding: 10px 16px;
    position: sticky; top: 0; z-index: 50;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  header > div { max-width: 720px; margin: 0 auto; }
  h1 { margin: 0; font-size: 18px; font-weight: 600; }
  #sync-indicator {
    background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 12px;
    white-space: nowrap;
  }
  h2 { margin: 0 0 12px; font-size: 18px; color: #1a3a5c; }
  nav {
    background: #fff; display: flex; overflow-x: auto;
    border-bottom: 1px solid #e1e6ed;
    position: sticky; top: 48px; z-index: 40;
  }
  nav button {
    flex: 1; min-width: 80px; padding: 14px 8px;
    background: none; border: none; font-size: 14px; font-weight: 600;
    color: #6a7890; cursor: pointer; border-bottom: 3px solid transparent;
    transition: all 0.15s;
  }
  nav button.active { color: #1a3a5c; border-bottom-color: #c0392b; }
  main { padding: 16px; padding-bottom: 100px; max-width: 720px; margin: 0 auto; }
  section { display: none; }
  section.active { display: block; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
  .filters select, .filters input {
    padding: 8px 10px; border: 1px solid #cfd7e2; border-radius: 6px;
    font-size: 14px; background: #fff; flex: 1; min-width: 100px;
  }
  .meal-card {
    background: #fff; border: 1px solid #e1e6ed; border-radius: 8px;
    padding: 12px; margin-bottom: 10px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }
  .meal-title { font-weight: 600; font-size: 16px; margin-bottom: 4px; }
  .meal-meta { font-size: 12px; color: #6a7890; margin-bottom: 8px; display: flex; flex-wrap: wrap; gap: 6px; }
  .meal-meta span {
    background: #eef2f7; padding: 2px 8px; border-radius: 10px; white-space: nowrap;
  }
  .meal-meta .recent { background: #fde5e2; color: #c0392b; }
  .meal-meta .fresh { background: #e2f0d9; color: #2d6a3f; }
  .meal-ingredients { font-size: 13px; color: #4a5a75; margin-bottom: 10px; }
  .meal-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  button.primary {
    background: #c0392b; color: #fff; border: none; padding: 8px 14px;
    border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;
  }
  button.secondary {
    background: #fff; color: #1a3a5c; border: 1px solid #cfd7e2; padding: 8px 14px;
    border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;
  }
  button.primary:active, button.secondary:active { transform: scale(0.98); }
  .big-btn {
    display: block; width: 100%; padding: 16px; margin-bottom: 10px;
    background: #1a3a5c; color: #fff; border: none; border-radius: 8px;
    font-size: 16px; font-weight: 600; cursor: pointer;
  }
  .big-btn.accent { background: #c0392b; }
  .big-btn.muted { background: #fff; color: #1a3a5c; border: 1px solid #cfd7e2; }
  .week-day {
    background: #fff; border: 1px solid #e1e6ed; border-radius: 8px;
    padding: 10px 12px; margin-bottom: 8px; display: flex; align-items: center; gap: 10px;
    cursor: pointer; transition: background 0.1s, border-color 0.1s;
  }
  .week-day:hover { background: #f4f7fb; border-color: #c8d2e0; }
  .week-day strong { min-width: 40px; color: #1a3a5c; }
  .week-day .slot {
    flex: 1; color: #6a7890; font-size: 14px;
  }
  .week-day .slot.filled { color: #1a2340; font-weight: 500; }
  .week-day button { padding: 6px 10px; font-size: 12px; }
  .week-day button.log-btn { color: #2d6a3f; font-weight: 700; }
  .week-day button.log-btn:hover { background: #e2f0d9; border-color: #c5e4c9; }
  .picker-list { max-height: 50vh; overflow-y: auto; margin-top: 12px; border: 1px solid #e1e6ed; border-radius: 8px; }
  .picker-item { padding: 10px 12px; border-bottom: 1px solid #e5ebf3; cursor: pointer; transition: background 0.1s; }
  .picker-item:last-child { border-bottom: none; }
  .picker-item:hover { background: #f0f4fa; }
  .picker-item-title { font-weight: 600; color: #1a2340; margin-bottom: 4px; }
  .picker-item-meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; color: #6a7890; }
  .picker-controls { display: flex; gap: 8px; flex-wrap: wrap; }
  .picker-controls input, .picker-controls select { flex: 1; min-width: 120px; }
  .day-picker-grid { display: grid; grid-template-columns: 1fr; gap: 6px; margin-top: 8px; }
  .day-picker-btn {
    text-align: left; padding: 10px 12px; background: #f4f7fb;
    border: 1px solid #d5dde8; border-radius: 8px; cursor: pointer;
    display: flex; align-items: center; gap: 12px; font-size: 14px;
    color: inherit; font-family: inherit;
  }
  .day-picker-btn:hover { background: #e3ecf6; }
  .day-picker-btn strong { color: #1a3a5c; min-width: 40px; }
  .day-picker-btn span { color: #6a7890; }
  .day-picker-btn.has-meal span { color: #1a2340; font-weight: 500; }
  .pantry-item {
    background: #fff; border: 1px solid #e1e6ed; border-radius: 6px;
    padding: 10px 12px; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;
    cursor: pointer;
  }
  .pantry-item .pantry-name { flex: 1; }
  .pantry-item.have { background: #f0faf1; border-color: #c5e4c9; }
  .pantry-item.have .pantry-name { color: #2d6a3f; font-weight: 400; }
  .pantry-item.need { background: #fef5f3; border-color: #f3c9c3; }
  .pantry-item.need .pantry-name { color: #c0392b; font-weight: 700; }
  .pantry-item button {
    padding: 6px 8px; font-size: 13px; min-width: 30px;
    border: 1px solid #cfd7e2; background: #fff; border-radius: 5px; cursor: pointer;
  }
  .pantry-item button.cart-btn { background: #fff; }
  .pantry-item button.cart-btn:hover { background: #eef2f7; }
  .pantry-item button.cart-btn.added { background: #c0392b; color: #fff; border-color: #c0392b; }
  .pantry-category { font-weight: 600; color: #1a3a5c; margin: 16px 0 6px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px; }
  .pantry-toggle { display: flex; gap: 6px; margin-bottom: 12px; }
  .pantry-toggle button {
    flex: 1; padding: 8px; border: 1px solid #cfd7e2; background: #fff;
    border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; color: #6a7890;
  }
  .pantry-toggle button.active { background: #1a3a5c; color: #fff; border-color: #1a3a5c; }
  .shopping-item {
    background: #fff; border: 1px solid #e1e6ed; border-radius: 6px;
    padding: 10px 12px; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;
  }
  .shopping-item .name { flex: 1; }
  .shopping-item.saved { background: #fafbfc; opacity: 0.85; }
  .shopping-item.saved .name { color: #6a7890; font-style: italic; }
  .shopping-item button {
    padding: 6px 10px; font-size: 13px;
    border: 1px solid #cfd7e2; background: #fff; border-radius: 5px; cursor: pointer;
  }
  .recipe-view {
    background: #fafbfc; border: 1px solid #e1e6ed; border-radius: 6px;
    padding: 12px; font-size: 14px; line-height: 1.6; white-space: pre-wrap;
    max-height: 400px; overflow-y: auto;
  }
  .history-item {
    background: #fff; border: 1px solid #e1e6ed; border-radius: 6px;
    padding: 12px; margin-bottom: 6px; display: flex; justify-content: space-between;
    align-items: center; gap: 8px;
  }
  .history-item > span:first-child { flex: 1; font-weight: 500; }
  .history-date { color: #6a7890; font-size: 13px; }
  .history-item input[type=date] {
    font-size: 13px; padding: 6px 8px;
    border: 1px solid #1a3a5c; border-radius: 6px;
    background: #eef2f7; color: #1a3a5c; font-weight: 500;
    cursor: pointer;
  }
  .history-item input[type=date]:hover { background: #dce4ee; }
  .history-item button.delete-x {
    padding: 6px 10px; font-size: 14px; font-weight: 700;
    color: #c0392b; background: #fff; border: 1px solid #e1e6ed;
    border-radius: 6px; cursor: pointer; min-width: 32px;
  }
  .history-item button.delete-x:hover { background: #fde5e2; }
  .ideas-form { background: #fff; border: 1px solid #e1e6ed; border-radius: 8px; padding: 14px; margin-bottom: 12px; }
  .ideas-form label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; }
  .ideas-form select, .ideas-form input {
    width: 100%; padding: 10px; border: 1px solid #cfd7e2; border-radius: 6px;
    font-size: 14px; margin-bottom: 12px;
  }
  .modal-bg {
    position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100;
    display: none; align-items: center; justify-content: center; padding: 16px;
  }
  .modal-bg.active { display: flex; }
  .modal {
    background: #fff; border-radius: 12px; padding: 20px; max-width: 500px; width: 100%;
    max-height: 90vh; overflow-y: auto;
  }
  .modal h3 { margin: 0 0 12px; }
  .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
  .modal input, .modal select, .modal textarea {
    width: 100%; padding: 10px; border: 1px solid #cfd7e2; border-radius: 6px;
    font-size: 14px; margin-bottom: 10px;
  }
  .modal label { font-weight: 600; font-size: 13px; margin-bottom: 4px; display: block; color: #4a5a75; }
  .empty-state { text-align: center; padding: 40px 20px; color: #6a7890; }
  .toast {
    position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
    background: #1a3a5c; color: #fff; padding: 12px 20px; border-radius: 20px;
    font-size: 14px; z-index: 200; opacity: 0; transition: opacity 0.3s;
    pointer-events: none;
  }
  .toast.show { opacity: 1; }
  .prompt-preview {
    background: #f5f7fa; border: 1px solid #cfd7e2; border-radius: 6px;
    padding: 12px; font-family: monospace; font-size: 12px; white-space: pre-wrap;
    max-height: 200px; overflow-y: auto; margin-bottom: 10px;
  }
  .fab {
    position: fixed; bottom: 20px; right: 20px; width: 56px; height: 56px;
    border-radius: 50%; background: #c0392b; color: #fff; border: none;
    font-size: 28px; cursor: pointer; box-shadow: 0 4px 12px rgba(192,57,43,0.4);
    z-index: 30;
  }
  @media (max-width: 400px) {
    nav button { font-size: 12px; padding: 12px 4px; }
  }
