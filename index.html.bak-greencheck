// ==================== SUPABASE SYNC ====================

const SUPABASE_URL = 'https://iwfbmlzffnojsqmwmnvn.supabase.co';
const SUPABASE_KEY = 'sb_publishable_KBVaAtUlX-_PEPQbE2TIZg_d35vVTrw';
let sb = null;
let realtimeChannel = null;

function updateSync(status) {
  const el = document.getElementById('sync-indicator');
  if (!el) return;
  const map = {
    syncing: '↻ Syncing',
    synced: '☁ Synced',
    offline: '⚠ Offline',
    error: '⚠ Error',
  };
  el.textContent = map[status] || '⋯';
}

async function initCloud() {
  if (!window.supabase) { updateSync('offline'); return; }
  try {
    sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
    updateSync('syncing');

    const [mealsRes, historyRes, weekRes, pantryRes, shoppingRes] = await Promise.all([
      sb.from('meals').select('*'),
      sb.from('dinner_history').select('*').order('date', { ascending: false }).limit(180),
      sb.from('weekly_plan').select('*'),
      sb.from('pantry').select('*'),
      sb.from('shopping_list').select('*').order('added_at', { ascending: false }),
    ]);

    if (mealsRes.error) throw mealsRes.error;
    if (historyRes.error) throw historyRes.error;
    if (weekRes.error) throw weekRes.error;
    if (pantryRes.error) throw pantryRes.error;
    if (shoppingRes.error) throw shoppingRes.error;

    if (mealsRes.data.length === 0) {
      await migrateLocalToCloud();
    } else {
      pullCloudIntoState(mealsRes.data, historyRes.data, weekRes.data, pantryRes.data, shoppingRes.data);
      save();
      renderAll();
    }

    subscribeToRealtime();
    updateSync('synced');
  } catch (e) {
    console.warn('Cloud init failed:', e);
    updateSync('offline');
  }
}

function pullCloudIntoState(meals, history, week, pantry, shopping) {
  state.meals = meals.map(m => ({
    n: m.name, p: m.protein, t: m.cook_time, c: m.category,
    i: m.ingredients, w: m.who_cooks, k: !!m.kid_approved,
    l: m.last_made || undefined,
    recipe: m.recipe || null
  }));
  state.history = history.map(h => ({ date: h.date, meal: h.meal_name }));
  state.week = {};
  week.forEach(w => { if (w.meal_name) state.week[w.day] = w.meal_name; });
  state.pantry = {};
  state.customPantry = {};
  const defaultItems = new Set();
  Object.values(DEFAULT_PANTRY).forEach(arr => arr.forEach(i => defaultItems.add(i)));
  pantry.forEach(p => {
    if (p.is_stocked) state.pantry[p.item] = true;
    if (!defaultItems.has(p.item)) {
      if (!state.customPantry[p.category]) state.customPantry[p.category] = [];
      if (!state.customPantry[p.category].includes(p.item)) {
        state.customPantry[p.category].push(p.item);
      }
    }
  });
  state.shoppingList = (shopping || []).map(s => ({
    item: s.item, saved: !!s.saved_for_later
  }));
}

async function migrateLocalToCloud() {
  if (!sb) return;
  try {
    // Push meals
    if (state.meals.length > 0) {
      const rows = state.meals.map(m => ({
        name: m.n, protein: m.p, cook_time: m.t, category: m.c,
        ingredients: m.i, who_cooks: m.w || 'Either',
        kid_approved: !!m.k, last_made: m.l || null
      }));
      await sb.from('meals').upsert(rows, { onConflict: 'name' });
    }
    // Push history
    if (state.history && state.history.length > 0) {
      await sb.from('dinner_history').insert(
        state.history.map(h => ({ meal_name: h.meal, date: h.date }))
      );
    }
    // Push week
    const weekRows = Object.entries(state.week || {}).map(([day, meal]) => ({
      day, meal_name: meal
    }));
    if (weekRows.length > 0) await sb.from('weekly_plan').upsert(weekRows);
    // Push pantry (all defaults + customs)
    const pantryRows = [];
    Object.entries(DEFAULT_PANTRY).forEach(([cat, items]) => {
      items.forEach(item => pantryRows.push({
        item, category: cat, is_stocked: !!state.pantry[item]
      }));
    });
    Object.entries(state.customPantry || {}).forEach(([cat, items]) => {
      items.forEach(item => pantryRows.push({
        item, category: cat, is_stocked: !!state.pantry[item]
      }));
    });
    if (pantryRows.length > 0) await sb.from('pantry').upsert(pantryRows);
  } catch (e) {
    console.error('Migration failed:', e);
    throw e;
  }
}

function subscribeToRealtime() {
  if (!sb) return;
  if (realtimeChannel) sb.removeChannel(realtimeChannel);
  realtimeChannel = sb
    .channel('pugh-household')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'meals' }, () => refetchTable('meals'))
    .on('postgres_changes', { event: '*', schema: 'public', table: 'dinner_history' }, () => refetchTable('dinner_history'))
    .on('postgres_changes', { event: '*', schema: 'public', table: 'weekly_plan' }, () => refetchTable('weekly_plan'))
    .on('postgres_changes', { event: '*', schema: 'public', table: 'pantry' }, () => refetchTable('pantry'))
    .on('postgres_changes', { event: '*', schema: 'public', table: 'shopping_list' }, () => refetchTable('shopping_list'))
    .subscribe();
}

async function refetchTable(tableName) {
  if (!sb) return;
  try {
    if (tableName === 'meals') {
      const { data } = await sb.from('meals').select('*');
      if (data) {
        state.meals = data.map(m => ({
          n: m.name, p: m.protein, t: m.cook_time, c: m.category,
          i: m.ingredients, w: m.who_cooks, k: !!m.kid_approved,
          l: m.last_made || undefined,
          recipe: m.recipe || null
        }));
      }
    } else if (tableName === 'dinner_history') {
      const { data } = await sb.from('dinner_history').select('*').order('date', { ascending: false }).limit(180);
      if (data) state.history = data.map(h => ({ date: h.date, meal: h.meal_name }));
    } else if (tableName === 'weekly_plan') {
      const { data } = await sb.from('weekly_plan').select('*');
      if (data) {
        state.week = {};
        data.forEach(w => { if (w.meal_name) state.week[w.day] = w.meal_name; });
      }
    } else if (tableName === 'pantry') {
      const { data } = await sb.from('pantry').select('*');
      if (data) {
        state.pantry = {};
        data.forEach(p => { if (p.is_stocked) state.pantry[p.item] = true; });
      }
    } else if (tableName === 'shopping_list') {
      const { data } = await sb.from('shopping_list').select('*').order('added_at', { ascending: false });
      if (data) {
        state.shoppingList = data.map(s => ({ item: s.item, saved: !!s.saved_for_later }));
      }
    }
    save();
    renderAll();
  } catch (e) { console.warn('Refetch failed:', e); }
}

// Cloud write helpers — used alongside local state updates
async function cloudWrite(fn, label) {
  if (!sb) return;
  try {
    await fn();
    updateSync('synced');
  } catch (e) {
    console.warn(`${label} sync failed:`, e);
    updateSync('offline');
  }
}

