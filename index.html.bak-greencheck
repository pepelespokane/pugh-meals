}

// ==================== PANTRY ====================

function setPantryFilter(filter) {
  state.pantryFilter = filter;
  document.querySelectorAll('[data-pfilter]').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.pfilter === filter);
  });
  save();
  renderPantry();
}

function isOnShoppingList(item) {
  return state.shoppingList.some(s => s.item.toLowerCase() === item.toLowerCase());
}

function renderPantry() {
  const el = document.getElementById('pantry-list');
  const deleted = new Set(state.deletedDefaults || []);
  const categories = {};
  Object.entries(DEFAULT_PANTRY).forEach(([cat, items]) => {
    categories[cat] = items.filter(i => !deleted.has(i));
  });
  Object.entries(state.customPantry || {}).forEach(([cat, items]) => {
    categories[cat] = [...(categories[cat] || []), ...items];
  });

  const filter = state.pantryFilter || 'all';
  let totalShown = 0;

  el.innerHTML = Object.entries(categories).map(([cat, items]) => {
    const filteredItems = items
      .filter(item => {
        const have = !!state.pantry[item];
        if (filter === 'have' && !have) return false;
        if (filter === 'need' && have) return false;
        return true;
      })
      .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));
    if (filteredItems.length === 0) return '';
    totalShown += filteredItems.length;
    return `<div class="pantry-category">${cat}</div>` +
      filteredItems.map(item => {
        const have = !!state.pantry[item];
        const klass = have ? 'have' : 'need';
        const onList = isOnShoppingList(item);
        return `
          <div class="pantry-item ${klass}">
            <span class="pantry-name" onclick="togglePantry('${escapeQ(item)}')">${have ? '✓ ' : ''}${item}</span>
            <button class="cart-btn ${onList ? 'added' : ''}" title="${onList ? 'On shopping list' : 'Add to shopping list'}"
              onclick="addPantryToShopping('${escapeQ(item)}')">🛒</button>
            <button title="Edit" onclick="editPantryItem('${escapeQ(item)}')">✎</button>
            <button title="Delete" onclick="deletePantryItem('${escapeQ(item)}')">✕</button>
          </div>`;
      }).join('');
  }).join('');

  if (totalShown === 0) {
    el.innerHTML = '<div class="empty-state">No items match this filter</div>';
  }
}

function togglePantry(item) {
  state.pantry[item] = !state.pantry[item];
  save();
  renderPantry();
  cloudWrite(async () => {
    // Find category (default or custom)
    let category = 'Other';
    for (const [cat, items] of Object.entries(DEFAULT_PANTRY)) {
      if (items.includes(item)) { category = cat; break; }
    }
    for (const [cat, items] of Object.entries(state.customPantry || {})) {
      if (items.includes(item)) { category = cat; break; }
    }
    await sb.from('pantry').upsert({
      item, category, is_stocked: !!state.pantry[item],
      updated_at: new Date().toISOString()
    });
  }, 'togglePantry');
}

function getPantryList() {
  return Object.keys(state.pantry).filter(k => state.pantry[k]);
}

function addPantryItem() {
  const allCategories = new Set([
    ...Object.keys(DEFAULT_PANTRY),
    ...Object.keys(state.customPantry || {})
  ]);
  const sortedCats = [...allCategories].sort();
  const content = document.getElementById('modal-content');
  content.innerHTML = `
    <h3>Add Pantry Item</h3>
    <label>Item name</label>
    <input id="ap-name" placeholder="e.g. Greek yogurt" autofocus>
    <label>Category</label>
    <select id="ap-category" onchange="document.getElementById('ap-newcat-wrap').style.display = this.value === '__new__' ? 'block' : 'none';">
      ${sortedCats.map(c => `<option value="${c}">${c}</option>`).join('')}
      <option value="__new__">+ New category…</option>
    </select>
    <div id="ap-newcat-wrap" style="display: none;">
      <label>New category name</label>
      <input id="ap-newcat" placeholder="e.g. Spices, Beverages">
    </div>
    <label><input type="checkbox" id="ap-stocked" checked> I currently have this</label>
    <div class="modal-actions">
      <button class="secondary" onclick="closeModal()">Cancel</button>
      <button class="primary" onclick="savePantryItem()">Add</button>
    </div>`;
  document.getElementById('modal').classList.add('active');
}

function savePantryItem() {
  const item = document.getElementById('ap-name').value.trim();
  if (!item) { toast("Item name required"); return; }
  let cat = document.getElementById('ap-category').value;
  if (cat === '__new__') {
    cat = document.getElementById('ap-newcat').value.trim();
    if (!cat) { toast("New category name required"); return; }
  }
  const stocked = document.getElementById('ap-stocked').checked;

  if (!state.customPantry[cat]) state.customPantry[cat] = [];
  const existing = [...(DEFAULT_PANTRY[cat] || []), ...(state.customPantry[cat] || [])];
  if (!existing.includes(item)) {
    state.customPantry[cat] = [...(state.customPantry[cat] || []), item];
  }
  state.pantry[item] = stocked;
  save();
  closeModal();
  renderPantry();
  toast(`✓ Added ${item}`);
  cloudWrite(async () => {
    await sb.from('pantry').upsert({ item, category: cat, is_stocked: stocked });
  }, 'addPantryItem');
}

function editPantryItem(oldItem) {
  const newItem = prompt("Rename pantry item:", oldItem);
  if (!newItem || newItem === oldItem) return;
  // Update in default/custom lists
  for (const [cat, items] of Object.entries(state.customPantry || {})) {
    const idx = items.indexOf(oldItem);
    if (idx >= 0) { items[idx] = newItem; break; }
  }
  // If it was a default item, add the renamed version as custom and hide the default via a flag
  const isDefault = Object.values(DEFAULT_PANTRY).some(arr => arr.includes(oldItem));
  if (isDefault) {
    // Find the default category
    let cat = 'Other';
    for (const [c, items] of Object.entries(DEFAULT_PANTRY)) {
      if (items.includes(oldItem)) { cat = c; break; }
    }
    if (!state.customPantry[cat]) state.customPantry[cat] = [];
    if (!state.customPantry[cat].includes(newItem)) state.customPantry[cat].push(newItem);
    // Track deleted defaults
    if (!state.deletedDefaults) state.deletedDefaults = [];
    if (!state.deletedDefaults.includes(oldItem)) state.deletedDefaults.push(oldItem);
  }
  if (state.pantry[oldItem]) {
    state.pantry[newItem] = true;
    delete state.pantry[oldItem];
  }
  save();
  renderPantry();
  cloudWrite(async () => {
    await sb.from('pantry').delete().eq('item', oldItem);
    let cat = 'Other';
    for (const [c, items] of Object.entries(DEFAULT_PANTRY)) {
      if (items.includes(oldItem)) { cat = c; break; }
    }
    for (const [c, items] of Object.entries(state.customPantry || {})) {
      if (items.includes(newItem)) { cat = c; break; }
    }
    await sb.from('pantry').upsert({ item: newItem, category: cat, is_stocked: !!state.pantry[newItem] });
  }, 'editPantryItem');
  toast(`Renamed → ${newItem}`);
}

function deletePantryItem(item) {
  if (!confirm(`Remove "${item}" from pantry?`)) return;
  // Remove from custom
  for (const [cat, items] of Object.entries(state.customPantry || {})) {
    const idx = items.indexOf(item);
    if (idx >= 0) items.splice(idx, 1);
  }
  // Mark default as deleted
  const isDefault = Object.values(DEFAULT_PANTRY).some(arr => arr.includes(item));
  if (isDefault) {
    if (!state.deletedDefaults) state.deletedDefaults = [];
    if (!state.deletedDefaults.includes(item)) state.deletedDefaults.push(item);
  }
  delete state.pantry[item];
  save();
  renderPantry();
  cloudWrite(async () => {
    await sb.from('pantry').delete().eq('item', item);
  }, 'deletePantryItem');
  toast(`Removed: ${item}`);
}

function addPantryToShopping(item) {
  if (isOnShoppingList(item)) {
    toast(`Already on shopping list`);
    return;
  }
  state.shoppingList.unshift({ item, saved: false });
  save();
  renderPantry();
  renderShopping();
  toast(`🛒 Added ${item}`);
  cloudWrite(async () => {
    await sb.from('shopping_list').insert({ item, saved_for_later: false });
  }, 'addPantryToShopping');
}

// ==================== HISTORY ====================

function renderHistory() {
  const el = document.getElementById('history-list');
  const recent = state.history.slice(0, 60);
  if (recent.length === 0) {
    el.innerHTML = '<div class="empty-state">No dinners logged yet. Use "Had this tonight" on a meal.</div>';
    return;
  }
  el.innerHTML = recent.map((h, idx) => `
    <div class="history-item">
      <span>${h.meal}</span>
      <input type="date" value="${h.date}" title="Tap to change date"
        onchange="updateHistoryDate(${idx}, this.value)">
      <button class="delete-x" title="Remove" onclick="removeHistoryEntry(${idx})">✕</button>
    </div>`).join('');
}

function removeHistoryEntry(idx) {
  const entry = state.history[idx];
  if (!entry) return;
  if (!confirm(`Remove "${entry.meal}" from ${entry.date}?`)) return;
  const { meal, date } = entry;
  state.history.splice(idx, 1);
  recalculateLastMade(meal);
  save();
  renderAll();
  toast("✓ Removed");
  cloudWrite(async () => {
    await sb.from('dinner_history').delete().eq('meal_name', meal).eq('date', date);
    const mealObj = state.meals.find(m => m.n === meal);
    if (mealObj) {
      await sb.from('meals').update({ last_made: mealObj.l || null }).eq('name', meal);
    }
  }, 'removeHistory');
}

function updateHistoryDate(idx, newDate) {
  if (!newDate) return;
  const entry = state.history[idx];
  if (!entry) return;
  const mealName = entry.meal;
  const oldDate = entry.date;
  entry.date = newDate;
  state.history.sort((a, b) => b.date.localeCompare(a.date));
  recalculateLastMade(mealName);
  save();
  renderAll();
  toast("✓ Date updated");
  cloudWrite(async () => {
    // Delete old, insert new (simpler than finding the row id)
    await sb.from('dinner_history').delete().eq('meal_name', mealName).eq('date', oldDate);
    await sb.from('dinner_history').insert({ meal_name: mealName, date: newDate });
    const mealObj = state.meals.find(m => m.n === mealName);
    if (mealObj) {
      await sb.from('meals').update({ last_made: mealObj.l || null }).eq('name', mealName);
    }
  }, 'updateHistoryDate');
}

function recalculateLastMade(mealName) {
  const meal = state.meals.find(m => m.n === mealName);
  if (!meal) return;
  const mostRecent = state.history.find(h => h.meal === mealName);
  meal.l = mostRecent ? mostRecent.date : undefined;
}

function addPastMeal() {
  const content = document.getElementById('modal-content');
  const sortedMeals = [...state.meals].sort((a, b) => a.n.localeCompare(b.n));
  const today = todayLocal();
  content.innerHTML = `
    <h3>Log a Past Meal</h3>
    <label>Meal</label>
    <select id="past-meal">
      ${sortedMeals.map(m => `<option value="${escapeQ(m.n)}">${m.n}</option>`).join('')}
    </select>
    <label>Date we ate it</label>
    <input type="date" id="past-date" value="${today}" max="${today}">
    <div class="modal-actions">
      <button class="secondary" onclick="closeModal()">Cancel</button>
      <button class="primary" onclick="savePastMeal()">Log it</button>
    </div>`;
  document.getElementById('modal').classList.add('active');
}

function savePastMeal() {
  const mealName = document.getElementById('past-meal').value;
  const date = document.getElementById('past-date').value;
  if (!mealName || !date) { toast("Pick a meal and date"); return; }
  state.history.unshift({ date, meal: mealName });
  state.history.sort((a, b) => b.date.localeCompare(a.date));
  state.history = state.history.slice(0, 180);
  recalculateLastMade(mealName);
  save();
  closeModal();
  renderAll();
  toast(`✓ Logged ${mealName} on ${date}`);
  cloudWrite(async () => {
    await sb.from('dinner_history').insert({ meal_name: mealName, date });
    const mealObj = state.meals.find(m => m.n === mealName);
    if (mealObj) {
      await sb.from('meals').update({ last_made: mealObj.l || null }).eq('name', mealName);
    }
  }, 'savePastMeal');
}

// ==================== SHOPPING LIST ====================

function renderShopping() {
  const active = state.shoppingList.filter(s => !s.saved);
  const saved = state.shoppingList.filter(s => s.saved);
  const activeEl = document.getElementById('shopping-active');
  const savedEl = document.getElementById('shopping-saved');
  if (!activeEl || !savedEl) return;

  if (active.length === 0) {
    activeEl.innerHTML = '<div class="empty-state" style="padding: 20px;">Nothing to buy. Add items from Pantry tab or manually above.</div>';
  } else {
    activeEl.innerHTML = active.map(s => `
      <div class="shopping-item">
        <span class="name">${s.item}</span>
        <button title="Save for later" onclick="moveShopping('${escapeQ(s.item)}', true)">💾</button>
        <button title="Remove" onclick="removeShopping('${escapeQ(s.item)}')">✕</button>
      </div>`).join('');
  }
  if (saved.length === 0) {
    savedEl.innerHTML = '<div style="color: #6a7890; font-size: 13px; padding: 8px;">Nothing saved for later.</div>';
  } else {
    savedEl.innerHTML = saved.map(s => `
      <div class="shopping-item saved">
        <span class="name">${s.item}</span>
        <button title="Move to active list" onclick="moveShopping('${escapeQ(s.item)}', false)">⬆</button>
        <button title="Remove" onclick="removeShopping('${escapeQ(s.item)}')">✕</button>
      </div>`).join('');
  }
}

function addShoppingManual() {
  const input = document.getElementById('shopping-new');
  const item = (input.value || '').trim();
  if (!item) return;
  if (isOnShoppingList(item)) { toast("Already on list"); return; }
  state.shoppingList.unshift({ item, saved: false });
  input.value = '';
  save();
  renderShopping();
  renderPantry();
  toast(`🛒 Added ${item}`);
  cloudWrite(async () => {
    await sb.from('shopping_list').insert({ item, saved_for_later: false });
  }, 'addShoppingManual');
}

function removeShopping(itemName) {
  const idx = state.shoppingList.findIndex(s => s.item === itemName);
  if (idx < 0) return;
  state.shoppingList.splice(idx, 1);
  save();
  renderShopping();
  renderPantry();
  cloudWrite(async () => {
    await sb.from('shopping_list').delete().eq('item', itemName);
  }, 'removeShopping');
}

function moveShopping(itemName, saveForLater) {
  const entry = state.shoppingList.find(s => s.item === itemName);
  if (!entry) return;
  entry.saved = saveForLater;
  save();
  renderShopping();
  toast(saveForLater ? "Moved to saved for later" : "Back to active list");
  cloudWrite(async () => {
    await sb.from('shopping_list').update({ saved_for_later: saveForLater }).eq('item', itemName);
  }, 'moveShopping');
}

function clearShoppingActive() {
  const active = state.shoppingList.filter(s => !s.saved);
  if (active.length === 0) return;
  if (!confirm(`Remove all ${active.length} active items?`)) return;
  state.shoppingList = state.shoppingList.filter(s => s.saved);
  save();
  renderShopping();
  renderPantry();
  toast("Active list cleared");
  cloudWrite(async () => {
    await sb.from('shopping_list').delete().eq('saved_for_later', false);
  }, 'clearShoppingActive');
}

