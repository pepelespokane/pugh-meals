// Calendar date (local YYYY-MM-DD) for a weekday in the CURRENT week.
// DAYS is Mon-first; JS getDay() is Sun=0..Sat=6.
function dateForWeekday(day) {
  const idx = DAYS.indexOf(day);
  if (idx < 0) return todayLocal();
  const now = new Date();
  const dow = now.getDay();
  const mondayOffset = (dow === 0 ? -6 : 1 - dow); // back up to this week's Monday
  const target = new Date(now);
  target.setDate(now.getDate() + mondayOffset + idx);
  return `${target.getFullYear()}-${String(target.getMonth() + 1).padStart(2, '0')}-${String(target.getDate()).padStart(2, '0')}`;
}

