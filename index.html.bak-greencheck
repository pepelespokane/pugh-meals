  const none = '<div style="color: #6a7890; font-size: 13px; padding: 4px 0 8px;">Nothing fits right now.</div>';
  el.innerHTML =
    '<h3 style="font-size: 14px; color: #1a3a5c; margin: 14px 0 8px;">🔁 Bring back — had this month, not in 2 weeks</h3>' +
